# Harvest Farm — Kebun Kripto — contoh env (SALIN ke .env, JANGAN commit file .env!)
# Isi nilai asli di Railway (Variables) atau file .env lokal. Jangan pernah
# tulis token / API key langsung di bot.py atau index.html.

# Token bot Telegram dari @BotFather
BOT_TOKEN=
# URL publik Mini App (index.html), mis. https://<user>.github.io/harvest-farm/
WEBAPP_URL=https://example.github.io/harvest-farm/
# Block ID AdGram dari partner.adsgram.ai (dipakai frontend; backend hanya
# memberi tahu frontend aktif/tidak). Kosongkan = iklan nonaktif.
ADSGRAM_BLOCK_ID=YOUR_ADSGRAM_BLOCK_ID
# API key FaucetPay (v1, scope send). Kosong = withdraw pending manual.
FAUCETPAY_API_KEY=
# Kunci admin untuk approve/reject withdraw:
# GET /api/withdrawals/admin?key=... dan POST dengan key yang sama.
WITHDRAW_ADMIN_KEY=isi-dengan-kunci-acak-panjang
# Port HTTP API (Railway mengisi otomatis; lokal default 8080)
PORT=8080
# Set 1 di produksi untuk mewajibkan initData Telegram asli (matikan
# fallback demo user_id). Biarkan kosong saat test lokal.
REQUIRE_INITDATA=
